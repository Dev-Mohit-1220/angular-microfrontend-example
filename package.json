{
  "name": "shopsphere-angular-microfrontends",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "start": "ng serve shell",
    "start:shell": "ng serve shell",
    "start:products": "ng serve products",
    "start:cart": "ng serve cart",
    "start:checkout": "ng serve checkout",
    "start:profile": "ng serve profile",
    "build:shell": "node scripts/write-federation-manifest.mjs && ng build shell",
    "build:products": "ng build products",
    "build:cart": "ng build cart",
    "build:checkout": "ng build checkout",
    "build:profile": "ng build profile",
    "build:all": "npm run build:shell && npm run build:products && npm run build:cart && npm run build:checkout && npm run build:profile",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@types/node": "^22.15.30",
    "typescript": "~6.0.3"
  }
}
